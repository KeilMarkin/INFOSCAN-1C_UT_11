 &НаСервере
Процедура ЗагрузитьВНоменклатуруНаСервере(СоздаватьНовыеШК = Ложь, стч = Неопределено)  
	
	Если стч = Неопределено Тогда
		Для Каждого строкатабчасти из Объект.HistoryOfScaning Цикл
			ЗаписьВНоменклатуру(СоздаватьНовыеШК, строкатабчасти);
		КонецЦикла;
	Иначе
		ЗаписьВНоменклатуру(СоздаватьНовыеШК, стч);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаписьВНоменклатуру(СоздаватьНовыеШК, Знач стч)
	
	Настройки = Справочники.isc_Настройки.ПолучитьНастройкиУстройстваПоУмолчанию();	
	сткВГХ = Новый Структура("Barcode,Length, Height, Width, Weight,Volume,ItemType", стч.Barcode, стч.Length, стч.Height,стч.Width, стч.Weight, стч.Volume, стч.Ratio );

	Попытка	
		
		// Каждое измерение может храниться в различных реквизитах
		isc_ОбщийМодуль.СохранитьВГХСогласноНастройкам(сткВГХ, стч, Настройки);
		
		Если СоздаватьНовыеШК И (стч.Status = Перечисления.isc_СтатусыРучнаяОбработка.ДанныеПолучены ИЛИ стч.Status = Перечисления.isc_СтатусыРучнаяОбработка.ШКУстановленВручную) Тогда 
			РСШК 				= РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьМенеджерЗаписи();
			РСШК.Штрихкод 		= стч.Barcode;
			РСШК.Номенклатура 	= стч.Номенклатура;
			РСШК.Характеристика = стч.Характеристика;
			РСШК.Упаковка 		= стч.Упаковка;
			РСШК.Записать(); 
			РегистрыСведений.isc_ЛогСобытий.ЗаписатьЛог(стч.Barcode, стч.Length , стч.Height , стч.Width ,стч. Weight , "Создан штрихкод для номенклатуры """ + стч.Номенклатура + """. Форма опроса устройства." );
		КонецЕсли;
		стч.Status = Перечисления.isc_СтатусыРучнаяОбработка.ДанныеЗаписаныВБД;
		РегистрыСведений.isc_ЛогСобытий.ЗаписатьЛог(стч.Barcode, стч.Length , стч.Height , стч.Width ,стч. Weight , "Записаны ВГХ. Форма опроса устройства." );
	Исключение
		стч.Status = Перечисления.isc_СтатусыРучнаяОбработка.ОшибкаСохраненияВБД;
		РегистрыСведений.isc_ЛогСобытий.ЗаписатьЛог(стч.Barcode, стч.Length , стч.Height , стч.Width ,стч. Weight , "Ошибка записи ВГХ. Форма опроса устройства." );
	КонецПопытки; 
	
КонецПроцедуры

 &НаСервере
Процедура ЗаполнитьТчНаСервере(ЧитатьИсторию = Ложь)      
	
	соотДанныеСОборудования = ПрочитатьДанныеОборудования(ЧитатьИсторию);	
	Если соотДанныеСОборудования = Ложь Или Не ЗначениеЗаполнено(соотДанныеСОборудования["barcode"]) Тогда Возврат; КонецЕсли;
	
	мНайденныхСтрок =  Объект.HistoryOfScaning.НайтиСтроки(Новый Структура("Barcode", соотДанныеСОборудования["barcode"]));
	Если мНайденныхСтрок.Количество() > 0 Тогда 
		// Заменим данные в таблице полученными данными
		стч = мНайденныхСтрок[0];	
	Иначе
		стч = Объект.HistoryOfScaning.Добавить();
	КонецЕсли;	
	стч.Barcode = соотДанныеСОборудования["barcode"];
	стч.Length 	= соотДанныеСОборудования["length"];
	стч.Width 	= соотДанныеСОборудования["width"];
	стч.Height 	= соотДанныеСОборудования["height"];
	стч.Weight 	= соотДанныеСОборудования["weight"];
	стч.Volume 	= соотДанныеСОборудования["volume"];
	стч.Ratio 	= соотДанныеСОборудования["ratio"];
	стч.Status = Перечисления.isc_СтатусыРучнаяОбработка.ДанныеПолучены;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Номенклатура КАК Номенклатура,
	|	ШтрихкодыНоменклатуры.Характеристика КАК Характеристика,
	|	ШтрихкодыНоменклатуры.Упаковка КАК Упаковка
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Штрихкод = &Штрихкод";
	Запрос.УстановитьПараметр("Штрихкод", соотДанныеСОборудования["barcode"]);	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(стч, Выборка);
		стч.Status = Перечисления.isc_СтатусыРучнаяОбработка.ШКСопоставлен;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьДанныеОборудования(ЧитатьИсторию) 
	
	соотДанныеСОборудования = Новый Соответствие;
	соотДанныеСОборудования.Вставить("barcode", "");
	соотДанныеСОборудования.Вставить("length", 0);
	соотДанныеСОборудования.Вставить("width", 0);
	соотДанныеСОборудования.Вставить("height", 0);
	соотДанныеСОборудования.Вставить("weight", 0);
	соотДанныеСОборудования.Вставить("volume", 0);
	соотДанныеСОборудования.Вставить("ratio", 1);
	ТелоОтвета =  УстановитьСоединениеНаСервере(ЭтаФорма.Устройство, Ложь, ЧитатьИсторию);
	
	Если ТелоОтвета = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьПоток(ТелоОтвета);
	Попытка
		стк = ПрочитатьJSON(Чтение);
	Исключение
		Сообщить("Ошибка парсинга.Проверьте алгоритм FinishSend.");
		ИнфаОбОшибке = ИнформацияОбОшибке();
		Сообщить(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнфаОбОшибке));
		Возврат Ложь;
	КонецПопытки;	
	Если ЧитатьИсторию Тогда
		Если Не ЗначениеЗаполнено(стк) Тогда
			
			Сообщить("История измерений пуста.");
			
		Иначе
			
			Для Каждого элемМассива Из стк Цикл
				Для Каждого Параметр из элемМассива.data Цикл
					
					соотДанныеСОборудования.Вставить(Параметр.Ключ, Параметр.Значение);	
					
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	Иначе
		Для Каждого Параметр из стк Цикл
			
			соотДанныеСОборудования.Вставить(Параметр.Ключ, Параметр.Значение);	
			
		КонецЦикла;
	КонецЕсли;
	
	Если соотДанныеСОборудования.Получить("ratio") = Неопределено Тогда
		соотДанныеСОборудования.Вставить("ratio", 1);
	КонецЕсли;
	Чтение.Закрыть();
	Возврат соотДанныеСОборудования;
	
КонецФункции

&НаКлиенте
Функция СформироватьИВернутьCSV()
	
	ТекстCSV = "Barcode;Length;Width;Height;Weight;Ratio;КодНоменклатуры;" + Символы.ПС;;
	Для Каждого стч Из Объект.HistoryOfScaning Цикл
		ТекстCSV = ТекстCSV + 
		стч.Barcode + ";" +
		стч.Length + ";" +
		стч.Width + ";" +
		стч.Height + ";" +
		стч.Weight + ";" +
		стч.Ratio + ";" +
		стч.Номенклатура + ";" +
		Символы.ПС;
	КонецЦикла;	
	Возврат ТекстCSV; 
	
КонецФункции

&НаСервере
Процедура ТестSOAPНаСервере()
	
	мСтрок = СтрРазделить(СтрЗаменить(ЭтаФорма.АдресПубликации, "?wsdl", ""), "/");
	Сервер = мСтрок[2];
	ЕндПойнт = "/" + мСтрок[3] + "/" + мСтрок[4] + "/" + мСтрок[5];
	Попытка
		Соединение = Новый HTTPСоединение(Сервер, 80, ЭтотОбъект.ТестЛогин, ЭтотОбъект.ТестПароль, , 30, );
	Исключение
		Сообщить("Не удалось подключиться к серверу: " + Сервер);
		Возврат;
	КонецПопытки;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept",       "application/json");
	
	ТелоЗапроса = 
	"<soapenv:Envelope xmlns:soapenv=""http://schemas.xmlsoap.org/soap/envelope/"" xmlns:tns=""iscan.com"">
	|  <soapenv:Header/>
	|  <soapenv:Body>
	|    <tns:SaveParametrs>
	|      <tns:Barcode>"
	 + ЭтотОбъект.ТестШтрихкод +
	"</tns:Barcode>
	|      <tns:Length>10.5</tns:Length>
	|      <tns:Height>5.0</tns:Height>
	|      <tns:Width>8.0</tns:Width>
	|      <tns:Weight>0.5</tns:Weight>
	|      <tns:Volume>0.5</tns:Volume>
	|      <tns:ItemType>1</tns:ItemType>
	|    </tns:SaveParametrs>
	|  </soapenv:Body>
	|</soapenv:Envelope>";
	
	Запрос = Новый HTTPЗапрос(ЕндПойнт, Заголовки);
	Запрос.УстановитьТелоИзСтроки(
    ТелоЗапроса,
    КодировкаТекста.UTF8,
    ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	ЭтаФорма.ОтветСервера = Ответ.ПолучитьТелоКакСтроку();
	
КонецПроцедуры
  
#КонецОбласти



